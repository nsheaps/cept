{
  "name": "cept",
  "version": "0.33.3",
  "private": true,
  "type": "module",
  "description": "A fully-featured Notion clone backed by Git. Client-only. Offline-first. Collaborative.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "docs",
    "e2e"
  ],
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:web": "nx run @cept/web:dev",
    "dev:desktop": "nx run @cept/desktop:dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test:unit test:integration",
    "test:unit": "nx run-many -t test:unit",
    "test:integration": "nx run-many -t test:integration",
    "test:e2e": "nx run @cept/e2e:test:e2e",
    "test:e2e:screenshots": "nx run @cept/e2e:test:screenshots",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "release": "release-it",
    "release:ci": "release-it --ci",
    "release:dry-run": "release-it --dry-run"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@nx/eslint-plugin": "23.2.1",
    "@playwright/test": "1.63.0",
    "@release-it/bumper": "8.0.0",
    "@release-it/conventional-changelog": "12.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/isomorphic-git__lightning-fs": "4.4.8",
    "@types/mdast": "4.0.4",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "nx": "23.2.1",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "release-it": "21.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@humanfs/node": "0.17.0",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16",
    "ip-address": "10.7.1",
    "linkify-it": "6.1.0",
    "lodash-es": "4.18.1",
    "markdown-it": "15.0.1",
    "prosemirror-model": "1.25.11",
    "prosemirror-transform": "1.12.1",
    "prosemirror-view": "1.42.3",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "uuid": "14.0.2"
  },
  "dependencies": {},
  "nx": {
    "includedScripts": []
  },
  "cept": {
    "skipTargets": {
      "build": "Repo-level scripts and tests; nothing to build."
    }
  }
}
