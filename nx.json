{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test:unit": {
      "cache": true
    },
    "test:integration": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/lint/**/*",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/docs/package.json",
        "{workspaceRoot}/e2e/package.json",
        "{workspaceRoot}/bun.lock"
      ]
    },
    "typecheck": {
      "cache": true
    }
  },
  "defaultBase": "main"
}
