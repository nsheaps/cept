{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/bunfig.toml",
      "{workspaceRoot}/.mise.toml",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/vitest.config.ts"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test:unit": {
      "cache": true
    },
    "test:integration": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "sharedGlobals",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/lint/**/*",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/docs/package.json",
        "{workspaceRoot}/e2e/package.json"
      ]
    },
    "typecheck": {
      "cache": true
    }
  },
  "defaultBase": "main"
}
